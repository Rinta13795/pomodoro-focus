{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "番茄专注",
  "version": "0.2.0",
  "identifier": "com.pomodoro.focus",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "番茄专注",
        "width": 520,
        "height": 760,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "minWidth": 420,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installMode": "currentUser"
      }
    },
    "shortDescription": "面向学习的番茄钟"
  },
  "mainBinaryName": "pomodoro-focus"
}
